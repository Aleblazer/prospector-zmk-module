if PROSPECTOR_STATUS_SCREEN_GOSSIP

config ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
    select LV_USE_LABEL
    select LV_USE_IMAGE
    select LV_USE_FLEX
    select LV_COLOR_SCREEN_TRANSP

# ZMK runs LVGL every 10 ms, so LVGL's default 33 ms refresh period
# lands on 40 ms: 25 frames a second. 30 ms lines up with the ticks for
# about 33. Keys move once per refresh (key_flight.c); the display thread
# measured about 55% busy at 25 frames a second, so there is room.
config LV_DEF_REFR_PERIOD
    default 30

endif
