/*
 * 2.25in 76x284 ST7789 Prospector wiring for nice!nano v2-compatible
 * Pro Micro footprint nRF52840 controllers.
 *
 * Display: SCK D15, MOSI D16, MISO D14 (unused), CS D10, DC D6,
 *          reset D5, backlight D9.
 * APDS9960: SDA D2, SCL D3, interrupt D4.
 */

/ {
    pwmleds {
        compatible = "pwm-leds";
        disp_bl: pwm_led_1 {
            pwms = <&pwm0 0 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
        };
    };
};

&pinctrl {
    prospector_pwm_default: prospector_pwm_default {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 1, 6)>;
            nordic,invert;
        };
    };

    prospector_pwm_sleep: prospector_pwm_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 1, 6)>;
            low-power-enable;
        };
    };
};

disp_spi: &pro_micro_spi {
    status = "okay";
    cs-gpios = <&pro_micro_d 10 GPIO_ACTIVE_LOW>;
};

/ {
    mipi_dbi {
        compatible = "zephyr,mipi-dbi-spi";
        spi-dev = <&pro_micro_spi>;
        dc-gpios = <&pro_micro_d 6 GPIO_ACTIVE_HIGH>;
        reset-gpios = <&pro_micro_d 5 GPIO_ACTIVE_LOW>;
        write-only;
        #address-cells = <1>;
        #size-cells = <0>;

        st7789: st7789v@0 {
            compatible = "sitronix,st7789v";
            mipi-max-frequency = <30000000>;
            mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
            reg = <0>;
            width = <76>;
            height = <284>;
            x-offset = <82>;
            y-offset = <18>;
            vcom = <0x19>;
            gctrl = <0x35>;
            vrhs = <0x12>;
            vdvs = <0x20>;
            mdac = <0x00>;
            gamma = <0x01>;
            colmod = <0x05>;
            lcm = <0x2c>;
            porch-param = [ 0c 0c 00 33 33 ];
            cmd2en-param = [ 5a 69 02 01 ];
            pwctrl1-param = [ a4 a1 ];
            pvgam-param = [ D0 04 0D 11 13 2B 3F 54 4C 18 0D 0B 1F 23 ];
            nvgam-param = [ D0 04 0C 11 13 2C 3F 44 51 2F 1F 1F 20 23 ];
            ram-param = [ 00 F0 ];
            rgb-param = [ CD 08 14 ];
        };
    };
};

&pro_micro_i2c {
    status = "okay";

    apds9960: apds9960@39 {
        compatible = "avago,apds9960";
        status = "okay";
        reg = <0x39>;
        int-gpios = <&pro_micro_d 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };
};

&pwm0 {
    status = "okay";
    pinctrl-0 = <&prospector_pwm_default>;
    pinctrl-1 = <&prospector_pwm_sleep>;
    pinctrl-names = "default", "sleep";
};
