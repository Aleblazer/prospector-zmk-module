/*
 * 2.79in 142x428 NV3007 Prospector wiring for nice!nano v2-compatible
 * Pro Micro footprint nRF52840 controllers.
 *
 * Display: SCK D15, MOSI D16, MISO D14 (unused), CS D10, DC D6,
 *          reset D5, backlight D9.
 * APDS9960: SDA D2, SCL D3, interrupt D4.
 */

/ {
    pwmleds {
        compatible = "pwm-leds";
        disp_bl: pwm_led_1 {
            pwms = <&pwm0 0 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
        };
    };
};

&pinctrl {
    prospector_pwm_default: prospector_pwm_default {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 1, 6)>;
            nordic,invert;
        };
    };

    prospector_pwm_sleep: prospector_pwm_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 1, 6)>;
            low-power-enable;
        };
    };
};

disp_spi: &pro_micro_spi {
    status = "okay";
    cs-gpios = <&pro_micro_d 10 GPIO_ACTIVE_LOW>;
};

/ {
    mipi_dbi {
        compatible = "zephyr,mipi-dbi-spi";
        spi-dev = <&pro_micro_spi>;
        dc-gpios = <&pro_micro_d 6 GPIO_ACTIVE_HIGH>;
        reset-gpios = <&pro_micro_d 5 GPIO_ACTIVE_LOW>;
        write-only;
        #address-cells = <1>;
        #size-cells = <0>;

        nv3007: nv3007@0 {
            compatible = "newvision,nv3007";
            reg = <0>;
            /* nrfx rounds this down to a supported SPIM rate (8/16/32 MHz). The ST7789
             * config asked for 30 MHz and actually ran at 16 MHz; 32 MHz corrupts the
             * pixel stream over jumper wires, so start at 8 MHz and raise it once the
             * panel is proven.
             */
            mipi-max-frequency = <8000000>;
            mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
            /* Native 142x428 portrait window of the 2.79in NV3007 panel;
             * display_rotate_init.c rotates it to a 428x142 landscape canvas.
             * The glass sits 12 columns into the 168-column frame memory.
             */
            width = <142>;
            height = <428>;
            x-offset = <12>;
            y-offset = <0>;
        };
    };
};

&pro_micro_i2c {
    status = "okay";

    apds9960: apds9960@39 {
        compatible = "avago,apds9960";
        status = "okay";
        reg = <0x39>;
        int-gpios = <&pro_micro_d 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };
};

&pwm0 {
    status = "okay";
    pinctrl-0 = <&prospector_pwm_default>;
    pinctrl-1 = <&prospector_pwm_sleep>;
    pinctrl-names = "default", "sleep";
};
