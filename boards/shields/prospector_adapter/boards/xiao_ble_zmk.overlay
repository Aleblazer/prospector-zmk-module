/ {
   pwmleds {
      compatible = "pwm-leds";
      disp_bl: pwm_led_1 {
          pwms = <&pwm1 0 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
      };
  };
};

&spi2 {
   status = "disabled";
};

&pinctrl {
   spi3_default: spi3_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
				<NRF_PSEL(SPIM_MOSI, 1, 15)>,
				<NRF_PSEL(SPIM_MISO, 1, 10)>;
		};
	};

	spi3_sleep: spi3_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
				<NRF_PSEL(SPIM_MOSI, 1, 15)>,
				<NRF_PSEL(SPIM_MISO, 1, 10)>;
			low-power-enable;
		};
	};

   pwm1_default: pwm1_default {
      group1 {
         psels = <NRF_PSEL(PWM_OUT0, 1, 11)>;
         nordic,invert;
      };
   };

   pwm1_sleep: pwm1_sleep {
      group1 {
         psels = <NRF_PSEL(PWM_OUT0, 1, 11)>;
         low-power-enable;
      };
   };
};

disp_spi: &spi3 {
   status = "okay";
   pinctrl-0 = <&spi3_default>;
	pinctrl-1 = <&spi3_sleep>;
	pinctrl-names = "default", "sleep";
   cs-gpios = <&xiao_d 9 GPIO_ACTIVE_LOW>;
};

/ {
   mipi_dbi {
       compatible = "zephyr,mipi-dbi-spi";
       spi-dev = <&spi3>;
       dc-gpios = <&xiao_d 7 GPIO_ACTIVE_HIGH>;
       reset-gpios = <&xiao_d 3 GPIO_ACTIVE_LOW>;
       write-only;
       #address-cells = <1>;
       #size-cells = <0>;

       nv3007: nv3007@0 {
           compatible = "newvision,nv3007";
           reg = <0>;
           /* nrfx rounds this down to a supported SPIM rate (8/16/32 MHz). The ST7789
            * config asked for 30 MHz and actually ran at 16 MHz; 32 MHz corrupts the
            * pixel stream over jumper wires, so start at 8 MHz and raise it once the
            * panel is proven.
            */
           mipi-max-frequency = <8000000>;
           mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
           /* Native 142x428 portrait window of the 2.79in NV3007 panel;
            * display_rotate_init.c rotates it to a 428x142 landscape canvas.
            * The glass sits 12 columns into the 168-column frame memory.
            */
           width = <142>;
           height = <428>;
           x-offset = <12>;
           y-offset = <0>;
       };
   };
};

&i2c1 {
   status = "okay";

   apds9960: apds9960@39 {
       compatible = "avago,apds9960";
       status = "okay";
       reg = <0x39>;
       int-gpios = <&xiao_d 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
   };
};

&pwm1 {
  status = "okay";
  pinctrl-0 = <&pwm1_default>;
  pinctrl-1 = <&pwm1_sleep>;
  pinctrl-names = "default", "sleep";
};
