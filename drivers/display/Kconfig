# NV3007 display driver configuration options
# SPDX-License-Identifier: Apache-2.0

menuconfig NV3007
	bool "NV3007 TFT LCD display driver"
	default y
	depends on DISPLAY
	depends on DT_HAS_NEWVISION_NV3007_ENABLED
	select MIPI_DBI
	help
	  Enable the driver for the NewVision NV3007 168x428 RGB TFT LCD
	  controller (4-wire SPI via the MIPI DBI API). Used by the 2.79"
	  142x428 IPS bar panels (e.g. EastRising ER-TFT2.79-1).

if NV3007

config NV3007_RESET_HOLD_MS
	int "Hardware reset pulse width (ms)"
	default 10
	help
	  How long the reset line is asserted when a reset GPIO is available on
	  the MIPI DBI bus.

config NV3007_RESET_RECOVERY_MS
	int "Delay after reset before sending commands (ms)"
	default 120

config NV3007_SLEEP_OUT_DELAY_MS
	int "Delay after Sleep Out before Display On (ms)"
	default 220
	help
	  The vendor sequence asks for 220 ms. Sleep Out is issued twice, once
	  to wake the controller before its registers are programmed and once
	  after, so this dominates the driver's startup time.

config NV3007_CLEAR_ON_INIT
	bool "Clear the whole frame memory during init"
	default y
	help
	  The glass is narrower than the controller's frame memory, so the
	  columns outside the visible window keep whatever they powered up
	  with and the panel displays them as a fringe of noise along one
	  edge. The application only ever draws inside the window, so clear
	  everything once at init. Costs one full frame of writes at startup.

config NV3007_INIT_F9
	bool "Send F1=0Eh and F9=17h separately (LVGL / Arduino_GFX init)"
	default y
	help
	  The EastRising demo writes F1 0E followed by a bare 17h with the F9
	  command commented out, so the 17h lands as a second F1 parameter.
	  LVGL and Arduino_GFX send F9 17 as its own command instead.

	  The datasheet defines F1 as pol_switch[7:0], a single byte that sets
	  where the polarity signal changes over, and the registers beside it
	  address the first and last half of the source enable and precharge
	  signals separately. A wrong changeover point therefore shows up as
	  banding confined to one half of the panel, which is what this fixed
	  on the 2.79" panel it was developed against. Turn it off to get the
	  literal vendor behaviour.

endif # NV3007
