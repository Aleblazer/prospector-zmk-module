# NV3007 display driver configuration options
# SPDX-License-Identifier: Apache-2.0

menuconfig NV3007
	bool "NV3007 TFT LCD display driver"
	default y
	depends on DT_HAS_NEWVISION_NV3007_ENABLED
	select MIPI_DBI
	help
	  Enable the driver for the NewVision NV3007 168x428 RGB TFT LCD
	  controller (4-wire SPI via the MIPI DBI API). Used by the 2.79"
	  142x428 IPS bar panels (e.g. EastRising ER-TFT2.79-1).

if NV3007

config NV3007_RESET_HOLD_MS
	int "Hardware reset pulse width (ms)"
	default 10
	help
	  How long the reset line is asserted when a reset GPIO is available on
	  the MIPI DBI bus.

config NV3007_RESET_RECOVERY_MS
	int "Delay after reset before sending commands (ms)"
	default 120

config NV3007_SLEEP_OUT_DELAY_MS
	int "Delay after Sleep Out before Display On (ms)"
	default 120

config NV3007_HW_ROTATION
	bool "Use the MADCTL row/column exchange bit for 90/270 degree orientations"
	help
	  By default the driver keeps the controller in its native portrait
	  addressing (the only mode the panel vendor's demo code exercises) and
	  transposes pixels in software for the landscape orientations. Enable
	  this to use the MADCTL MV bit instead, which is cheaper but unverified
	  on the NV3007.

config NV3007_INIT_F9
	bool "Send F9=17h (LVGL / Arduino_GFX init) instead of the vendor's stray byte"
	help
	  The EastRising demo writes F1 0E followed by a bare 17h with the F9
	  command commented out; LVGL and Arduino_GFX send F9 17 instead. F1
	  takes a single parameter per the datasheet, so the two differ in
	  whether F9 is programmed. Enable to use the LVGL variant.

config NV3007_SPI_MODE3
	bool "Force SPI mode 3 (CPOL=1, CPHA=1) regardless of devicetree"
	help
	  The vendor demo bit-bangs the panel with the clock idling high and the
	  ESP-IDF port uses SPI mode 3. The MIPI DBI node's mipi-cpol/mipi-cpha
	  properties do the same thing; this option is a build-time override
	  for bring-up without touching the overlay.

config NV3007_INIT_TEST_PATTERN
	bool "Paint a test pattern from the driver after init (debug)"
	help
	  After the init sequence the driver turns the panel on and fills it
	  with red / green / blue bars along the long axis, a white 1-pixel
	  border, and a black square in the red bar, then holds the image for
	  NV3007_INIT_TEST_PATTERN_HOLD_MS before returning. Use it to prove
	  the SPI link, window offsets, orientation and colour order without
	  LVGL in the loop. Boot is delayed by the hold time.

config NV3007_INIT_F9
	bool "Send F9=17h (LVGL / Arduino_GFX init) instead of the vendor's stray byte"
	help
	  The EastRising demo writes F1 0E followed by a bare 17h with the F9
	  command commented out; LVGL and Arduino_GFX send F9 17 instead. F1
	  takes a single parameter per the datasheet, so the two differ in
	  whether F9 is programmed. Enable to use the LVGL variant.

config NV3007_SPI_MODE3
	bool "Force SPI mode 3 (CPOL=1, CPHA=1) regardless of devicetree"
	help
	  The vendor demo bit-bangs the panel with the clock idling high and the
	  ESP-IDF port uses SPI mode 3. The MIPI DBI node's mipi-cpol/mipi-cpha
	  properties do the same thing; this option is a build-time override
	  for bring-up without touching the overlay.

config NV3007_INIT_TEST_PATTERN_HOLD_MS
	int "Test pattern hold time (ms)"
	default 3000
	depends on NV3007_INIT_TEST_PATTERN

endif # NV3007
